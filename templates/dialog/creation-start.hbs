<div class="afc-test-dialog afc-creation-start">
  <p class="hint">{{localize "AFC.Creation.Intro"}}</p>
  <label>{{localize tables.originLabel}}
    <select name="origin">
      <option value="">—</option>
      {{#if tables.originRoll}}<option value="random">{{localize "AFC.Creation.RandomRealm"}}</option>{{/if}}
      {{selectOptions origins selected=selected localize=true}}
    </select>
  </label>
  <label>{{localize "AFC.Creation.Founding"}}
    <select name="founding">
      <option value="random">{{localize "AFC.Creation.RandomFounding"}}</option>
      {{selectOptions foundings localize=true}}
    </select>
  </label>
  <p class="hint">{{localize "AFC.Creation.Warning"}}</p>
</div>
