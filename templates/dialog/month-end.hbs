<div class="afc-test-dialog afc-month-dialog">
  <h3>{{localize "AFC.Month.StepIncome"}}</h3>
  <div class="row two">
    <label>{{localize "AFC.Month.Pay"}}
      <input type="number" name="pay" value="{{#if contractActive}}{{system.contract.pay}}{{else}}0{{/if}}" min="0">
    </label>
    <p class="hint">{{#if contractActive}}{{localize "AFC.Month.ContractInfo" employer=system.contract.employer n=system.contract.months}}{{else}}{{localize "AFC.Month.NoContract"}}{{/if}}</p>
  </div>
  <div class="row two">
    <label>{{localize "AFC.Month.Loot"}}<input type="number" name="loot" value="0" min="0"></label>
    <label>{{localize "AFC.Month.LootShared"}}<input type="number" name="lootShared" value="0" min="0"></label>
  </div>
  <div class="loot-split">
    <span class="presets">
      <a data-loot-share="0">0 %</a><a data-loot-share="25">25 %</a><a data-loot-share="50">50 %</a><a data-loot-share="75">75 %</a><a data-loot-share="100">100 %</a>
    </span>
    <span class="hint" data-loot-preview></span>
  </div>

  <h3>{{localize "AFC.Month.StepUpkeep"}}</h3>
  <p>{{localize "AFC.Month.UpkeepInfo" n=system.monthlySupply supply=system.supply}}
    {{#if (lt system.supply system.monthlySupply)}}<strong class="warn">{{localize "AFC.Month.UpkeepWarn"}}</strong>{{/if}}</p>
  {{#if hasMonthlyServices}}
  <label class="checkbox"><input type="checkbox" name="serviceEffects" checked> {{localize "AFC.Month.ServiceEffects"}}</label>
  {{/if}}

  <h3>{{localize "AFC.Month.StepAction"}}</h3>
  <select name="action">{{selectOptions actions selected="none" localize=true}}</select>

  <h3>{{localize "AFC.Month.StepEvent"}}</h3>
  <label class="checkbox"><input type="checkbox" name="rollEvent"> {{localize "AFC.Month.RollEvent"}}</label>
  <label>{{localize "AFC.Month.Steward"}}
    <select name="steward"><option value="">—</option>{{selectOptions stewardOptions selected=steward}}</select>
  </label>
</div>
