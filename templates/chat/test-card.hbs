<div class="afc-test-card {{#if outcome}}{{#if outcome.success}}success{{else}}failure{{/if}}{{/if}}">
  <header>
    <h3>{{label}}{{#if specialty}} <small>({{specialty}})</small>{{/if}}</h3>
    <span class="pool">{{rank}}d6{{#if bonus}} +{{bonus}}{{localize "AFC.Roll.BonusAbbr"}}{{/if}}{{#if penalty}} −{{penalty}}{{localize "AFC.Roll.PenaltyAbbr"}}{{/if}}{{#if modifier}} {{numberFormat modifier sign=true}}{{/if}}</span>
  </header>
  <ol class="dice">
    {{#each dice as |d|}}<li class="die d{{d.value}} {{#unless d.kept}}dropped{{/unless}}">{{d.value}}</li>{{/each}}
  </ol>
  <div class="total">{{total}}</div>
  {{#if outcome}}
  <div class="outcome">
    {{localize outcomeLabel}}
    <small>{{localize "AFC.Roll.Against"}} {{localize difficultyLabel}} ({{difficulty}})</small>
  </div>
  {{/if}}
</div>
