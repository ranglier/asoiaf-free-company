<div class="afc-card battle melee">
  <div class="verdict">
    <span class="seal">{{#if degrees}}{{degrees}}{{else}}={{/if}}</span>
    <div><strong>{{verdict}}</strong><small>{{detail}}</small></div>
  </div>

  {{#each sides as |s|}}
  <div class="side {{#if s.winner}}winner{{/if}}">
    <div class="who"><strong class="troop">{{s.name}}</strong><small>{{s.roller}} · {{s.order}}</small></div>
    <div class="total">{{s.total}}</div>
    <ol class="dice">{{#each s.dice as |d|}}<li class="die d{{d.value}} {{#unless d.kept}}dropped{{/unless}}">{{d.value}}</li>{{/each}}</ol>
    <footer><span class="pool">{{s.pool}}</span>{{#each s.tags}}<span class="tag">{{this}}</span>{{/each}}</footer>
  </div>
  {{/each}}

  {{#if pending}}<div class="battle-outcome"><small>{{pending}}</small></div>{{/if}}
  {{#if apply}}<div class="battle-outcome"></div><button type="button" data-afc-battle="apply" data-token="{{apply.token}}" data-losses="{{apply.losses}}"><i class="fa-solid fa-heart-crack"></i> {{localize "AFC.Battle.ApplyLosses"}}</button>{{/if}}
</div>
