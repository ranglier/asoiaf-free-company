<div class="afc-card battle report">
  <div class="report-head"><strong>{{localize "AFC.Battle.ReportCard.Title"}}</strong><small>{{localize "AFC.Battle.ReportCard.Rounds" n=rounds}}</small></div>
  {{#each sides as |side|}}
  <div class="report-side side-{{side.key}}"><b>{{side.label}}</b><span>{{localize "AFC.Battle.ReportCard.Lost" lost=side.lost men=side.men pct=side.pct}}</span></div>
  {{#each side.rows as |r|}}
  <div class="report-row" {{#if r.facts}}data-tooltip="{{r.facts}}"{{/if}}><span class="troop">{{r.name}}</span><span class="state-chip {{r.state}}">{{r.stateLabel}}</span><span class="men">−{{r.lostMen}}</span></div>
  {{/each}}
  {{#if side.intact}}<div class="report-row intact">{{side.intact}}</div>{{/if}}
  {{/each}}
  <button type="button" data-afc-battle="publish"><i class="fa-solid fa-bullhorn"></i> {{localize "AFC.Battle.ReportCard.Publish"}}</button>
</div>
