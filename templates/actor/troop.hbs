<div class="afc-sheet parchment troop-profile {{#if editMode}}edit-mode{{else}}play-mode{{/if}}">
  <header class="afc-header">
    <img class="portrait" src="{{actor.img}}" data-action="editImage" alt="{{actor.name}}" data-tooltip="AFC.Battle.ChangeImage">
    <div class="identity">
      {{#if editMode}}
      <input class="name" type="text" name="name" value="{{actor.name}}">
      <div class="grid-3">
        <label>{{localize "AFC.Battle.Side.label"}}<select name="system.side">{{selectOptions sides selected=system.side localize=true}}</select></label>
        <label>{{localize "AFC.Battle.UnitType"}}<select name="system.unitType"><option value=""></option>{{selectOptions types selected=system.unitType}}</select></label>
        <label>{{localize "AFC.Unit.training"}}<select name="system.training">{{selectOptions trainings selected=system.training localize=true}}</select></label>
        <label>{{localize "AFC.Unit.unitType2"}}<select name="system.unitType2"><option value="">{{localize "AFC.Unit.NoSecondType"}}</option>{{selectOptions types selected=system.unitType2}}</select></label>
        {{#if bookRules}}<label>{{localize "AFC.BattleBook.TypeLabel"}}<select name="system.book.type">{{selectOptions bookTypes selected=system.book.type localize=true}}</select></label>
        {{#if isSpecial}}<label>{{localize "AFC.Battle.Range"}}<select name="system.book.specialRange">{{selectOptions bookRanges selected=system.book.specialRange localize=true}}</select></label>{{/if}}{{/if}}
      </div>
      {{#if customImage}}<a class="add-item" data-action="resetImage"><i class="fa-solid fa-rotate-left"></i> {{localize "AFC.Battle.ResetImage"}}</a>{{/if}}
      {{else}}
      <h1 class="name">{{actor.name}}</h1>
      <p class="subtitle">{{subtitle}}</p>
      {{/if}}
    </div>
    <div class="header-side">
      {{> "systems/asoiaf-free-company/templates/actor/parts/mode-toggle.hbs"}}
    </div>
  </header>

  {{!-- Profil : les valeurs de la troupe en une ligne. --}}
  <div class="profile-line" style="--n: {{profile.length}}">
    {{#each profile as |p|}}
    <div class="profile-cell" {{#if p.hint}}data-tooltip="{{p.hint}}"{{/if}}>
      <span class="label">{{localize p.label}}</span>
      {{#if p.input}}{{#if @root.editMode}}<input type="number" name="{{p.input}}" value="{{p.raw}}" min="0">{{else}}<span class="value">{{p.value}}</span>{{/if}}
      {{else if p.roll}}{{#if @root.editable}}<a class="value" data-action="rollSkill" data-ability="{{p.roll}}" data-tooltip="AFC.Roll.QuickHint">{{p.value}}</a>{{else}}<span class="value">{{p.value}}</span>{{/if}}
      {{else}}<span class="value">{{p.value}}</span>{{/if}}
    </div>
    {{/each}}
  </div>

  {{!-- État : échelle cliquable, dans les deux modes (il bouge en bataille). --}}
  <div class="state-ladder">
    <span class="label">{{localize stateLabel}}</span>
    {{#each states as |s|}}{{#unless @first}}<i class="fa-solid fa-angle-right"></i>{{/unless}}<a class="step {{#if s.on}}on{{/if}} {{#if s.past}}past{{/if}}" data-action="setState" data-state="{{s.key}}">{{localize s.label}}</a>{{/each}}
  </div>

  {{!-- Compteurs : pastilles cliquables (re-clic sur la dernière = la retire). --}}
  <div class="counters">
    {{#each counters as |c|}}
    <span class="counter" {{#if c.hint}}data-tooltip="{{c.hint}}"{{/if}}><span class="label">{{localize c.label}}</span>
      {{#if c.pips}}<span class="pips">{{#each c.pips as |p|}}<a class="pip {{#if p.on}}on{{/if}}" data-action="setPip" data-path="{{c.path}}" data-n="{{p.n}}"></a>{{/each}}</span>{{/if}}
      {{#if c.text}}<b>{{c.text}}</b>{{/if}}
      {{#if c.input}}<input type="number" name="{{c.input}}" value="{{c.raw}}" min="0">{{/if}}
    </span>
    {{/each}}
    {{#if bookRules}}<label class="counter"><span class="label">{{localize "AFC.BattleBook.FormationLabel"}}</span><select name="system.book.formation">{{selectOptions bookFormations selected=system.book.formation localize=true}}</select></label>{{/if}}
  </div>

  {{!-- Traits et améliorations : étiquettes en jeu, cases à cocher en édition. --}}
  {{#if editMode}}
  <div class="section-title">
    <h2>{{localize "AFC.Unit.Upgrade.title"}}</h2>
  </div>
  <div class="troop-traits">
    {{#each upgrades as |u|}}<label class="checkbox" data-tooltip="{{u.effect}}"><input type="checkbox" name="{{u.name}}" {{checked u.on}}> {{localize u.label}}</label>{{/each}}
  </div>
  {{#unless bookRules}}
  <div class="section-title">
    <h2>{{localize "AFC.Battle.Traits"}}</h2>
    <a class="add-item" data-action="resetTraits"><i class="fa-solid fa-rotate"></i> {{localize "AFC.Battle.ResetTraits"}}</a>
  </div>
  <div class="troop-traits">
    {{#each traits as |t|}}<label class="checkbox" data-tooltip="{{t.effect}}"><input type="checkbox" name="trait.{{t.key}}" {{checked t.on}}> {{t.label}}</label>{{/each}}
  </div>
  {{/unless}}
  {{else}}
  <div class="trait-chips">
    {{#unless bookRules}}{{#each activeTraits as |t|}}<span class="chip" data-tooltip="{{t.effect}}">{{t.label}}</span>{{/each}}{{/unless}}
    {{#each upgrades as |u|}}{{#if u.on}}<span class="chip upgrade" data-tooltip="{{u.effect}}"><i class="fa-solid fa-hammer"></i> {{localize u.label}}</span>{{/if}}{{/each}}
  </div>
  {{/if}}

  {{!-- Autres compétences : une ligne en jeu, une grille de rangs en édition. --}}
  {{#if editMode}}
  <div class="section-title">
    <h2>{{localize "AFC.Battle.Skills"}}</h2>
    <a class="add-item" data-action="resetBook"><i class="fa-solid fa-rotate"></i> {{localize "AFC.BattleBook.ResetUnit"}}</a>
  </div>
  <div class="book-abilities">
    {{#each bookAbilities as |a|}}<label class="book-ability">{{a.name}}<input type="number" name="system.book.abilities.{{a.key}}" value="{{a.value}}" min="1" max="9"></label>{{/each}}
  </div>
  {{else}}
  <p class="other-abilities"><span class="label">{{localize "AFC.Battle.OtherSkills"}}</span>
    {{#each otherAbilities as |a|}}{{#if @root.editable}}<a data-action="rollSkill" data-ability="{{a.key}}" data-tooltip="AFC.Roll.QuickHint">{{a.name}} {{a.value}}</a>{{else}}<span>{{a.name}} {{a.value}}</span>{{/if}}{{#unless @last}} · {{/unless}}{{/each}}
  </p>
  {{/if}}

  <label class="troop-notes">{{localize "AFC.Battle.Notes"}}<input type="text" name="system.notes" value="{{system.notes}}"></label>
</div>
