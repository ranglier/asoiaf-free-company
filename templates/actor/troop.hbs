<div class="afc-sheet parchment {{#if editMode}}edit-mode{{else}}play-mode{{/if}}">
  <header class="afc-header">
    <img class="portrait" src="{{actor.img}}" data-action="editImage" alt="{{actor.name}}" data-tooltip="AFC.Battle.ChangeImage">
    <div class="identity">
      {{#if editMode}}
      <input class="name" type="text" name="name" value="{{actor.name}}">
      <div class="grid-3">
        <label>{{localize "AFC.Battle.Side.label"}}<select name="system.side">{{selectOptions sides selected=system.side localize=true}}</select></label>
        <label>{{localize "AFC.Battle.UnitType"}}<select name="system.unitType"><option value=""></option>{{selectOptions types selected=system.unitType}}</select></label>
        <label>{{localize "AFC.Unit.training"}}<select name="system.training">{{selectOptions trainings selected=system.training localize=true}}</select></label>
        <label>{{localize "AFC.Unit.unitType2"}}<select name="system.unitType2"><option value="">{{localize "AFC.Unit.NoSecondType"}}</option>{{selectOptions types selected=system.unitType2}}</select></label>
        {{#if bookRules}}<label>{{localize "AFC.BattleBook.TypeLabel"}}<select name="system.book.type">{{selectOptions bookTypes selected=system.book.type localize=true}}</select></label>
        {{#if isSpecial}}<label>{{localize "AFC.Battle.Range"}}<select name="system.book.specialRange">{{selectOptions bookRanges selected=system.book.specialRange localize=true}}</select></label>{{/if}}{{/if}}
      </div>
      {{#if customImage}}<a class="add-item" data-action="resetImage"><i class="fa-solid fa-rotate-left"></i> {{localize "AFC.Battle.ResetImage"}}</a>{{/if}}
      {{else}}
      <h1 class="name">{{actor.name}}</h1>
      <p class="subtitle">{{subtitle}}</p>
      {{/if}}
    </div>
    <div class="header-side">
      {{> "systems/asoiaf-free-company/templates/actor/parts/mode-toggle.hbs"}}
    </div>
  </header>

  {{!-- Pistes de bataille, comme les pistes de santé d'un PJ : modifiables dans les deux modes. --}}
  <section class="afc-vitals troop-tracks">
    {{#each tracks as |c|}}
    <div class="vital" {{#if c.hint}}data-tooltip="{{c.hint}}"{{/if}}>
      <span class="label">{{localize c.label}}</span>
      {{#if c.pips}}<span class="pips">{{#each c.pips as |p|}}<a class="pip {{#if p.on}}on{{/if}}" data-action="{{#if c.state}}setState{{else}}setPip{{/if}}" data-path="{{c.path}}" data-n="{{p.n}}" data-state="{{p.key}}" {{#if p.label}}data-tooltip="{{localize p.label}}"{{/if}}></a>{{/each}}</span>{{/if}}
      {{#if c.text}}<span class="value">{{c.text}}</span>{{/if}}
      {{#if c.input}}<span class="value"><input type="number" name="{{c.input}}" value="{{c.raw}}" min="0"></span>{{/if}}
      {{#if c.note}}<span class="hint">{{c.note}}</span>{{/if}}
    </div>
    {{/each}}
  </section>

  <div class="troop-columns">
    {{!-- Compétences en registre, comme sur la fiche de PJ. --}}
    <section class="afc-ability-groups troop-abilities">
      <div class="ability-group">
        <h3>{{localize "AFC.Battle.Skills"}}</h3>
        {{#each bookAbilities as |a|}}
        <div class="ability-row">
          {{#if @root.editable}}<a class="ability-name" data-action="rollSkill" data-ability="{{a.key}}" data-tooltip="AFC.Roll.QuickHint">{{a.name}}</a>{{else}}<span class="ability-name">{{a.name}}</span>{{/if}}
          <span class="specialties"></span>
          {{#if @root.editMode}}<input class="rank" type="number" name="system.book.abilities.{{a.key}}" value="{{a.value}}" min="1" max="9" aria-label="{{a.name}}">{{else}}<span class="rank-value">{{a.value}}</span>{{/if}}
        </div>
        {{/each}}
        {{#if editMode}}<a class="add-item" data-action="resetBook"><i class="fa-solid fa-rotate"></i> {{localize "AFC.BattleBook.ResetUnit"}}</a>{{/if}}
      </div>
    </section>

    {{!-- Valeurs de bataille, traits et améliorations. --}}
    <section class="afc-ability-groups troop-stats">
      <div class="ability-group">
        <h3>{{localize "AFC.Battle.Troop"}}</h3>
        {{#each stats as |p|}}
        <div class="ability-row" {{#if p.hint}}data-tooltip="{{p.hint}}"{{/if}}>
          <span class="ability-name">{{localize p.label}}</span>
          <span class="specialties"></span>
          {{#if p.pips}}<span class="pips">{{#each p.pips as |q|}}<a class="pip {{#if q.on}}on{{/if}}" data-action="setPip" data-path="{{p.path}}" data-n="{{q.n}}"></a>{{/each}}</span>
          {{else if p.select}}<select name="{{p.select}}">{{selectOptions p.options selected=p.raw localize=true}}</select>
          {{else if p.input}}{{#if @root.editMode}}<input class="rank" type="number" name="{{p.input}}" value="{{p.raw}}" min="0">{{else}}<span class="rank-value">{{p.value}}</span>{{/if}}
          {{else}}<span class="rank-value">{{p.value}}</span>{{/if}}
        </div>
        {{/each}}
        {{#unless editMode}}
        <div class="trait-chips">
          {{#unless bookRules}}{{#each activeTraits as |t|}}<span class="chip" data-tooltip="{{t.effect}}">{{t.label}}</span>{{/each}}{{/unless}}
          {{#each upgrades as |u|}}{{#if u.on}}<span class="chip upgrade" data-tooltip="{{u.effect}}"><i class="fa-solid fa-hammer"></i> {{localize u.label}}</span>{{/if}}{{/each}}
        </div>
        {{/unless}}
      </div>
    </section>
  </div>

  {{#if editMode}}
  <div class="section-title"><h2>{{localize "AFC.Unit.Upgrade.title"}}</h2></div>
  <div class="troop-traits">
    {{#each upgrades as |u|}}<label class="checkbox" data-tooltip="{{u.effect}}"><input type="checkbox" name="{{u.name}}" {{checked u.on}}> {{localize u.label}}</label>{{/each}}
  </div>
  {{#unless bookRules}}
  <div class="section-title">
    <h2>{{localize "AFC.Battle.Traits"}}</h2>
    <a class="add-item" data-action="resetTraits"><i class="fa-solid fa-rotate"></i> {{localize "AFC.Battle.ResetTraits"}}</a>
  </div>
  <div class="troop-traits">
    {{#each traits as |t|}}<label class="checkbox" data-tooltip="{{t.effect}}"><input type="checkbox" name="trait.{{t.key}}" {{checked t.on}}> {{t.label}}</label>{{/each}}
  </div>
  {{/unless}}
  {{/if}}

  <label class="troop-notes">{{localize "AFC.Battle.Notes"}}<input type="text" name="system.notes" value="{{system.notes}}"></label>
</div>
