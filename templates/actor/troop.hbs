<div class="afc-sheet parchment {{#if editMode}}edit-mode{{else}}play-mode{{/if}}">
  <header class="afc-header">
    <img class="portrait" src="{{actor.img}}" data-action="editImage" alt="{{actor.name}}" data-tooltip="AFC.Battle.ChangeImage">
    <div class="identity">
      {{#if editMode}}
      <input class="name" type="text" name="name" value="{{actor.name}}">
      <div class="grid-3">
        <label>{{localize "AFC.Battle.Side.label"}}<select name="system.side">{{selectOptions sides selected=system.side localize=true}}</select></label>
        <label>{{localize "AFC.Battle.UnitType"}}<select name="system.unitType"><option value=""></option>{{selectOptions types selected=system.unitType}}</select></label>
        <label>{{localize "AFC.Unit.training"}}<select name="system.training">{{selectOptions trainings selected=system.training localize=true}}</select></label>
        <label class="span-3">{{localize "AFC.Unit.unitType2"}}<select name="system.unitType2"><option value="">{{localize "AFC.Unit.NoSecondType"}}</option>{{selectOptions types selected=system.unitType2}}</select></label>
      </div>
      {{#if customImage}}<a class="add-item" data-action="resetImage"><i class="fa-solid fa-rotate-left"></i> {{localize "AFC.Battle.ResetImage"}}</a>{{/if}}
      {{else}}
      <h1 class="name">{{actor.name}}</h1>
      <p class="subtitle">{{subtitle}}</p>
      {{/if}}
    </div>
    <div class="header-side">
      {{> "systems/asoiaf-free-company/templates/actor/parts/mode-toggle.hbs"}}
    </div>
  </header>

  {{#if bookRules}}
  <section class="afc-vitals troop-vitals">
    <div class="vital"><span class="label">{{localize "AFC.BattleBook.StatusLabel"}}</span><select name="system.book.status">{{selectOptions bookStatuses selected=system.book.status localize=true}}</select></div>
    <div class="vital big"><span class="label">{{localize "AFC.BattleBook.Health"}}</span><span class="value">{{system.book.healthLeft}} / {{system.book.health}}</span></div>
    <div class="vital"><span class="label">{{localize "AFC.BattleBook.DamageTaken"}}</span><span class="value"><input type="number" name="system.book.damage" value="{{system.book.damage}}" min="0"></span></div>
    <div class="vital"><span class="label">{{localize "AFC.BattleBook.Penalties"}}</span><span class="value"><input type="number" name="system.book.penalties" value="{{system.book.penalties}}" min="0"></span></div>
    <div class="vital"><span class="label">{{localize "AFC.Battle.Men"}}</span><span class="value"><input class="wide" type="number" name="system.men" value="{{system.men}}" min="0"></span></div>
    <div class="vital big"><span class="label">{{localize "AFC.BattleBook.Defense"}}</span><span class="value">{{system.book.defense}}</span></div>
    <div class="vital big"><span class="label">{{localize "AFC.BattleBook.ArmorRating"}}</span><span class="value">{{system.book.ar}}</span></div>
    <div class="vital big"><span class="label">{{localize "AFC.BattleBook.FightDamage"}}</span><span class="value">{{system.book.fightDamage}}</span></div>
    <div class="vital big"><span class="label">{{localize "AFC.BattleBook.ShootDamage"}}</span><span class="value">{{#if system.book.shoot}}{{system.book.shoot.damage}}{{else}}—{{/if}}</span></div>
    <div class="vital big"><span class="label">{{localize "AFC.BattleBook.MoveYards"}}</span><span class="value">{{system.book.moveYards}}</span></div>
    <div class="vital big"><span class="label">{{localize "AFC.BattleBook.Discipline"}}</span><span class="value">{{#if editMode}}<input type="number" name="system.discipline" value="{{system.discipline}}" min="0">{{else}}{{system.discipline}}{{/if}}</span></div>
    <div class="vital big" data-tooltip="AFC.Character.passiveAwarenessHint"><span class="label">{{localize "AFC.Character.passiveAwareness"}}</span><span class="value">{{system.passive.awareness}}</span></div>
  </section>
  {{else}}
  <section class="afc-vitals troop-vitals">
    <div class="vital"><span class="label">{{localize "AFC.Battle.StateLabel"}}</span><select name="system.state">{{selectOptions states selected=system.state localize=true}}</select></div>
    <div class="vital"><span class="label">{{localize "AFC.Battle.Cushion"}}</span><span class="value"><input type="number" name="system.cushion" value="{{system.cushion}}" min="0"> / {{system.cushionMax}}</span></div>
    <div class="vital"><span class="label">{{localize "AFC.Battle.Disorders"}}</span><span class="value"><input type="number" name="system.disorders" value="{{system.disorders}}" min="0"></span></div>
    <div class="vital"><span class="label">{{localize "AFC.Battle.Rallies"}}</span><span class="value"><input type="number" name="system.rallies" value="{{system.rallies}}" min="0"> / {{system.ralliesMax}}</span></div>
    <div class="vital"><span class="label">{{localize "AFC.Battle.Men"}}</span><span class="value"><input class="wide" type="number" name="system.men" value="{{system.men}}" min="0"></span></div>
    <div class="vital big"><span class="label">{{localize "AFC.Battle.Loss"}}</span><span class="value">{{system.loss}} %</span><span class="hint">{{localize "AFC.Battle.LostMen" n=system.lostMen}}</span></div>
    <div class="vital big"><span class="label">{{localize "AFC.Battle.Discipline"}}</span><span class="value">{{#if editMode}}<input type="number" name="system.discipline" value="{{system.discipline}}" min="0">{{else}}{{system.discipline}}{{/if}}</span></div>
    <div class="vital big"><span class="label">{{localize "AFC.Battle.Move"}}</span><span class="value">{{system.move}}</span></div>
    <div class="vital big"><span class="label">{{localize "AFC.Battle.Range"}}</span><span class="value">{{#if system.range}}{{system.range}}{{else}}—{{/if}}</span></div>
    <div class="vital big" data-tooltip="AFC.Character.passiveAwarenessHint"><span class="label">{{localize "AFC.Character.passiveAwareness"}}</span><span class="value">{{system.passive.awareness}}</span></div>
  </section>
  {{/if}}

  {{> "systems/asoiaf-free-company/templates/actor/parts/tabs-nav.hbs"}}

  <div class="tab-body">
    <section class="tab {{tabs.abilities.cssClass}}" data-group="primary" data-tab="abilities">
      {{#if editMode}}<div class="section-title">
        <p class="hint">{{#unless bookRules}}{{localize "AFC.Battle.SkillsHint"}}{{/unless}}</p>
        <a class="add-item" data-action="resetBook"><i class="fa-solid fa-rotate"></i> {{localize "AFC.BattleBook.ResetUnit"}}</a>
      </div>{{else}}{{#unless bookRules}}<p class="hint">{{localize "AFC.Battle.SkillsHint"}}</p>{{/unless}}{{/if}}
      <div class="afc-ability-groups troop-abilities">
        <section class="ability-group">
          {{#each bookAbilities as |a|}}
          <div class="ability-row">
            {{#if @root.editable}}<a class="ability-name" data-action="rollSkill" data-ability="{{a.key}}" data-tooltip="AFC.Roll.QuickHint">{{a.name}}</a>{{else}}<span class="ability-name">{{a.name}}</span>{{/if}}
            <span class="specialties"></span>
            {{#if @root.editMode}}<input class="rank" type="number" name="system.book.abilities.{{a.key}}" value="{{a.value}}" min="1" max="9" aria-label="{{a.name}}">{{else}}<span class="rank-value">{{a.value}}</span>{{/if}}
          </div>
          {{/each}}
        </section>
      </div>
      <p class="hint footer-hint">{{localize "AFC.Roll.QuickHintLong"}}</p>
    </section>

    <section class="tab {{tabs.troop.cssClass}}" data-group="primary" data-tab="troop">
      {{#if bookRules}}
      <div class="grid-3">
        <label>{{localize "AFC.BattleBook.TypeLabel"}}{{#if editMode}}<select name="system.book.type">{{selectOptions bookTypes selected=system.book.type localize=true}}</select>{{else}}<b>{{localize bookTypeLabel}}</b>{{/if}}</label>
        <label>{{localize "AFC.BattleBook.FormationLabel"}}<select name="system.book.formation">{{selectOptions bookFormations selected=system.book.formation localize=true}}</select></label>
        {{#if isSpecial}}<label>{{localize "AFC.Battle.Range"}}{{#if editMode}}<select name="system.book.specialRange">{{selectOptions bookRanges selected=system.book.specialRange localize=true}}</select>{{else}}<b>{{localize bookRangeLabel}}</b>{{/if}}</label>{{/if}}
      </div>
      {{/if}}

      <h2>{{localize "AFC.Unit.Upgrade.title"}}</h2>
      {{#if editMode}}
      <div class="troop-traits">
        {{#each upgrades as |u|}}<label class="checkbox" data-tooltip="{{u.effect}}"><input type="checkbox" name="{{u.name}}" {{checked u.on}}> {{localize u.label}}</label>{{/each}}
      </div>
      {{else}}
      <div class="trait-chips">{{#each upgrades as |u|}}{{#if u.on}}<span class="chip" data-tooltip="{{u.effect}}">{{localize u.label}}</span>{{/if}}{{/each}}{{#unless hasUpgrade}}—{{/unless}}</div>
      {{/if}}

      {{#unless bookRules}}
      <div class="section-title">
        <h2>{{localize "AFC.Battle.Traits"}}</h2>
        {{#if editMode}}<a class="add-item" data-action="resetTraits"><i class="fa-solid fa-rotate"></i> {{localize "AFC.Battle.ResetTraits"}}</a>{{/if}}
      </div>
      {{#if editMode}}
      <div class="troop-traits">
        {{#each traits as |t|}}<label class="checkbox" data-tooltip="{{t.effect}}"><input type="checkbox" name="trait.{{t.key}}" {{checked t.on}}> {{t.label}}</label>{{/each}}
      </div>
      {{else}}
      <div class="trait-chips">{{#each activeTraits as |t|}}<span class="chip" data-tooltip="{{t.effect}}">{{t.label}}</span>{{else}}—{{/each}}</div>
      {{/if}}
      {{/unless}}

      <h2>{{localize "AFC.Battle.Notes"}}</h2>
      <input type="text" name="system.notes" value="{{system.notes}}">
    </section>
  </div>
</div>
