<div class="afc-sheet parchment {{#if editMode}}edit-mode{{else}}play-mode{{/if}}">
  <header class="afc-header">
    {{#if actor.img}}
    <img class="portrait" src="{{actor.img}}" data-action="editImage" data-edit="img" alt="{{actor.name}}">
    {{/if}}
    <div class="identity">
      {{#if editMode}}
      <input class="name" type="text" name="name" value="{{actor.name}}">
      <div class="grid-3">
        <label>{{localize "AFC.Character.alias"}}<input type="text" name="system.alias" value="{{system.alias}}"></label>
        <label>{{localize "AFC.Character.house"}}<input type="text" name="system.house" value="{{system.house}}"></label>
        <label>{{localize "AFC.Character.role"}}<input type="text" name="system.role" value="{{system.role}}"></label>
        <label>{{localize "AFC.Character.age"}}<select name="system.age">{{selectOptions config.AGES selected=system.age localize=true}}</select></label>
        <label>{{localize "AFC.Character.gender"}}<input type="text" name="system.gender" value="{{system.gender}}"></label>
        <label>{{localize "AFC.Character.motto"}}<input type="text" name="system.motto" value="{{system.motto}}"></label>
      </div>
      {{else}}
      <h1 class="name">{{actor.name}}</h1>
      <p class="subtitle">
        {{#if system.alias}}« {{system.alias}} » · {{/if}}{{#each items.blood as |b|}}{{b.name}} · {{/each}}{{#if system.role}}{{system.role}} · {{/if}}{{localize (lookup config.AGES system.age)}}
      </p>
      {{#if system.motto}}<p class="motto">{{system.motto}}</p>{{/if}}
      {{/if}}
    </div>
    <div class="header-side">
      <div class="destiny">
        <span class="label">{{localize "AFC.Character.destiny"}}</span>
        <span class="pips">{{#each track.destiny as |p|}}<a class="pip seal {{#if p.on}}on{{/if}}" data-action="setPip" data-path="system.destiny.value" data-n="{{p.n}}"></a>{{/each}}</span>
        {{#if editMode}}<label class="inline">max <input type="number" name="system.destiny.max" value="{{system.destiny.max}}" min="0"></label>{{/if}}
      </div>
      {{> "systems/asoiaf-free-company/templates/actor/parts/mode-toggle.hbs"}}
    </div>
  </header>

  {{> "systems/asoiaf-free-company/templates/actor/parts/vitals.hbs"}}

  {{> "systems/asoiaf-free-company/templates/actor/parts/tabs-nav.hbs"}}

  <div class="tab-body">
    <section class="tab {{tabs.abilities.cssClass}}" data-group="primary" data-tab="abilities">
      {{> "systems/asoiaf-free-company/templates/actor/parts/abilities.hbs"}}
      <p class="hint footer-hint">{{localize "AFC.Roll.QuickHintLong"}}</p>
    </section>

    <section class="tab {{tabs.combat.cssClass}}" data-group="primary" data-tab="combat">
      {{> "systems/asoiaf-free-company/templates/actor/parts/weapons.hbs"}}
      <div class="combat-ref">
        <span>{{localize "AFC.Character.defenseIntrigue"}} <strong>{{system.defense.intrigue}}</strong></span>
        <span>{{localize "AFC.Character.composure"}} <strong>{{system.composure.value}} / {{system.composure.max}}</strong></span>
      </div>
    </section>

    <section class="tab {{tabs.equipment.cssClass}}" data-group="primary" data-tab="equipment">
      <h2>{{localize "AFC.Plural.armor"}}</h2>
      {{> "systems/asoiaf-free-company/templates/actor/parts/armor.hbs"}}

      <h2>{{localize "AFC.Plural.weapon"}}</h2>
      <table class="afc-table">
        <thead><tr>
          <th class="col-equip">{{localize "AFC.Table.equipped"}}</th>
          <th>{{localize "AFC.Table.weapon"}}</th>
          <th class="center">{{localize "AFC.Weapon.defenseBonus"}}</th>
          <th class="center">{{localize "AFC.Armor.bulk"}}</th>
          <th></th>
        </tr></thead>
        <tbody>
        {{#each items.weapon as |item|}}
        <tr data-item-id="{{item.id}}" class="{{#unless item.system.equipped}}unequipped{{/unless}}">
          <td class="col-equip"><input type="checkbox" data-action="toggleEquipped" {{checked item.system.equipped}}></td>
          <td><div class="item-name"><img src="{{item.img}}" alt=""><a data-action="editItem">{{item.name}}</a></div></td>
          <td class="center">{{#if item.system.defenseBonus}}+{{item.system.defenseBonus}}{{else}}—{{/if}}</td>
          <td class="center">{{item.system.bulk}}</td>
          <td class="item-actions">{{#if @root.editable}}<a class="icon" data-action="deleteItem" data-tooltip="{{localize "Delete"}}"><i class="fa-solid fa-trash"></i></a>{{/if}}</td>
        </tr>
        {{/each}}
        </tbody>
      </table>
      <p class="hint">{{localize "AFC.Table.totalBulk"}} : {{system.armor.bulk}}</p>
    </section>

    <section class="tab {{tabs.qualities.cssClass}}" data-group="primary" data-tab="qualities">
      {{> "systems/asoiaf-free-company/templates/actor/parts/qualities.hbs"}}
    </section>

    <section class="tab {{tabs.biography.cssClass}}" data-group="primary" data-tab="biography">
      <prose-mirror name="system.biography" value="{{system.biography}}" toggled>{{{enrichedHtml}}}</prose-mirror>
    </section>
  </div>
</div>
