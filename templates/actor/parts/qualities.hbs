      <h2>{{localize "AFC.Plural.blood"}}</h2>
      <ul class="item-list">
        {{#each items.blood as |item|}}
        <li data-item-id="{{item.id}}"><img src="{{item.img}}" alt=""><a data-action="editItem">{{item.name}}</a>
          {{#if item.system.summary}}<span class="summary">{{item.system.summary}}</span>{{/if}}
          {{#if item.system.destiny}}<span class="tag">{{localize "AFC.Quality.destinyTag" n=item.system.destiny}}</span>{{/if}}
          {{#if @root.editable}}<a class="icon" data-action="deleteItem" aria-label="{{localize "Delete"}}"><i class="fa-solid fa-trash"></i></a>{{/if}}</li>
        {{/each}}
      </ul>
      {{#if editable}}<button type="button" class="small add-button" data-action="createItem" data-type="blood"><i class="fa-solid fa-plus"></i> {{localize "AFC.Sheet.AddBlood"}}</button>{{/if}}
      <h2>{{localize "AFC.Plural.quality"}}</h2>
      <ul class="item-list">
        {{#each items.quality as |item|}}
        <li data-item-id="{{item.id}}"><img src="{{item.img}}" alt=""><a data-action="editItem">{{item.name}}</a>
          <span class="tag">{{localize (concat "AFC.Quality." item.system.kind)}}</span>
          {{#if item.system.destiny}}<span class="tag">{{localize "AFC.Quality.destinyTag" n=item.system.destiny}}</span>{{/if}}
          {{#if @root.editable}}<a class="icon" data-action="deleteItem" aria-label="{{localize "Delete"}}"><i class="fa-solid fa-trash"></i></a>{{/if}}</li>
        {{/each}}
      </ul>
      {{#if editable}}<button type="button" class="small add-button" data-action="createItem" data-type="quality"><i class="fa-solid fa-plus"></i> {{localize "AFC.Sheet.AddQuality"}}</button>{{/if}}
