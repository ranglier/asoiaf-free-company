<section class="afc-abilities">
  <h2>{{localize "AFC.Sheet.Abilities"}}</h2>
  <ol class="ability-list">
    {{#each abilities as |ab|}}
    <li class="ability" data-ability="{{ab.key}}">
      <div class="ability-row">
        <button type="button" class="ability-roll" data-action="rollAbility" data-ability="{{ab.key}}"
                data-tooltip="{{localize "AFC.Roll.Roll"}}">
          <i class="fa-solid fa-dice-d6"></i> {{localize ab.label}}
        </button>
        <input class="rank" type="number" name="system.abilities.{{ab.key}}.rank" value="{{ab.rank}}"
               min="1" max="7" {{disabled (not @root.editable)}}>
        {{#if @root.editable}}
        <button type="button" class="icon" data-action="addSpecialty" data-ability="{{ab.key}}"
                data-tooltip="{{localize "AFC.Sheet.AddSpecialty"}}"><i class="fa-solid fa-plus"></i></button>
        {{/if}}
      </div>
      {{#if ab.specialties.length}}
      <ul class="specialties">
        {{#each ab.specialties as |sp idx|}}
        <li>
          <input type="text" name="system.abilities.{{ab.key}}.specialties.{{idx}}.name" value="{{sp.name}}"
                 placeholder="{{localize "AFC.Sheet.Specialty"}}" {{disabled (not @root.editable)}}>
          <input class="bonus" type="number" name="system.abilities.{{ab.key}}.specialties.{{idx}}.bonus"
                 value="{{sp.bonus}}" min="0" max="7" {{disabled (not @root.editable)}}><span>{{localize "AFC.Roll.BonusAbbr"}}</span>
          {{#if @root.editable}}
          <button type="button" class="icon" data-action="removeSpecialty" data-ability="{{ab.key}}" data-index="{{idx}}">
            <i class="fa-solid fa-xmark"></i></button>
          {{/if}}
        </li>
        {{/each}}
      </ul>
      {{/if}}
    </li>
    {{/each}}
  </ol>
</section>
