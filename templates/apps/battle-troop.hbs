<div class="battle-troop side-{{t.side}} state-{{t.state}}{{#if t.inactive}} inactive{{/if}}{{#if t.missing}} missing{{/if}}" data-troop="{{t.id}}">
  <img class="symbol" src="{{t.img}}" alt="" data-action="focus" data-tooltip="AFC.Battle.Focus">
  <div class="body">
    <div class="line main">
      <span class="who">
        <a class="name fit" data-action="focus">{{t.name}}</a>
        {{#if t.hex}}<span class="tag hex" data-tooltip="AFC.Battle.Rules.hexTip">{{t.hex}}</span>{{/if}}
        {{#if t.hidden}}<i class="fa-solid fa-eye-slash" data-tooltip="AFC.Battle.Hidden"></i>{{/if}}
        {{#if t.known}}<a class="icon" data-action="openTroop" data-tooltip="AFC.Battle.OpenSheet"><i class="fa-solid fa-file-lines"></i></a>{{/if}}
      </span>
      <span class="state-cell">{{#unless t.unknown}}<span class="tag state">{{localize t.stateLabel}}</span>{{/unless}}</span>

      <span class="order-cell">
        {{#unless t.inactive}}
        {{#if t.canSet}}
        <select data-order>
          <option value="">{{localize "AFC.Battle.Waiting"}}</option>
          {{#each t.orderOptions as |o|}}<option value="{{o.key}}" {{#if o.selected}}selected{{/if}} {{#if o.disabled}}disabled{{/if}}>{{o.label}}</option>{{/each}}
        </select>
        {{else if t.showOrder}}
        <span class="tag order"><i class="fa-solid {{t.orderIcon}}"></i> {{t.orderText}}</span>
        {{else if t.secret}}
        <span class="tag">{{localize "AFC.Battle.OrderGiven"}}</span>
        {{else if t.known}}
        <span class="tag muted">{{localize "AFC.Battle.Waiting"}}</span>
        {{/if}}
        {{#if t.targeted}}{{#if t.showOrder}}
        <span class="target fit"><i class="fa-solid fa-arrow-right"></i> {{#if t.targetName}}{{t.targetName}}{{else}}<i>{{localize "AFC.Battle.NoTarget"}}</i>{{/if}}</span>
        {{#if t.canSet}}<a class="icon" data-action="pickTarget" data-tooltip="AFC.Battle.PickOnMap"><i class="fa-solid fa-crosshairs"></i></a>
        {{#if t.targetName}}<a class="icon" data-action="clearTarget" data-tooltip="AFC.Battle.ClearTarget"><i class="fa-solid fa-xmark"></i></a>{{/if}}{{/if}}
        {{/if}}{{/if}}
        {{#if t.canPickMove}}<a class="icon {{#if t.moveSet}}active{{/if}}" data-action="pickMove" data-tooltip="AFC.Battle.Moves.Button"><i class="fa-solid fa-route"></i></a>{{/if}}
        {{#if t.countered}}<small>{{localize "AFC.Battle.Countered"}}</small>{{/if}}
        {{/unless}}
      </span>

      <span class="officer-cell">
        {{#if t.known}}{{#unless t.inactive}}
        <i class="fa-solid fa-user-tie" {{#unless t.officerName}}data-tooltip="AFC.Battle.NoOfficerRank"{{/unless}}></i> {{#if t.officerName}}<span class="oname fit">{{t.officerName}}</span>{{#if t.officerNote}} <small>({{t.officerNote}})</small>{{/if}}{{else}}<span class="oname muted">—</span>{{/if}}
        {{#if t.mine}}<a class="icon" data-action="officer" data-tooltip="AFC.Battle.OfficerButton"><i class="fa-solid fa-pen"></i></a>{{/if}}
        {{#if t.canOfficerCommand}}{{#if t.officerBusy}}<span data-tooltip="{{t.officerBusy}}"><button type="button" class="small icon" disabled><i class="fa-solid fa-bullhorn"></i></button></span>{{else}}<button type="button" class="small icon" data-action="command" data-tooltip="AFC.Battle.Options.commandButton"><i class="fa-solid fa-bullhorn"></i></button>{{/if}}{{/if}}
        {{/unless}}{{/if}}
        {{#if t.canRally}}<button type="button" class="small icon" data-action="rally" data-tooltip="AFC.Battle.Rally"><i class="fa-solid fa-flag"></i></button>{{/if}}
        {{#if t.overload}}<i class="fa-solid fa-triangle-exclamation warn" data-tooltip="{{localize "AFC.Battle.TooMany" n=t.overload}}"></i>{{/if}}
      </span>
    </div>
    {{#if t.known}}{{#unless t.inactive}}
    <div class="line stats fit">{{t.stats}}{{#each t.traits as |tr|}}{{#if @first}} · {{else}}, {{/if}}<span class="trait" data-tooltip="{{tr.effect}}">{{tr.name}}</span>{{/each}}</div>
    {{/unless}}{{/if}}
  </div>
</div>
